{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghost Browser",
  "version": "0.5.0",
  "identifier": "com.brendigo.ghostbrowser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Ghost Browser",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Brendigo",
    "copyright": "Copyright © 2026 Brendigo",
    "category": "Productivity",
    "shortDescription": "Private Windows web browser",
    "longDescription": "Ghost Browser is a privacy-focused Windows browser with strict tracking prevention, local favorites and history, a Windows-protected password vault, memory saving and no Ghost application telemetry.",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma",
        "languages": ["English"]
      }
    }
  }
}
